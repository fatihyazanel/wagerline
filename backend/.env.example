# ==================== APP ====================
NODE_ENV=development
API_PORT=3101
API_HOST=0.0.0.0
DEFAULT_LANGUAGE=en

# ==================== DATABASE ====================
DATABASE_PATH=./data/wagerline.db
DATABASE_URL=sqlite:./data/wagerline.db

# ==================== PROVIDER KEYS ====================

# SportDB - https://api.sportdb.dev/api
SPORTDB_KEY=

# SportScore - https://sportscore.com/api
SPORTSCORE_KEY=

# TheSportsDB - https://www.thesportsdb.com/api (public API, no key required)
THESPORTSDB_KEY=123

# API-Sports - https://www.api-football.com (premium service)
API_SPORTS_KEY=

# ==================== CACHE TTL (seconds) ====================
CACHE_TTL_SPORTS=604800
CACHE_TTL_COMPETITIONS=86400
CACHE_TTL_TEAMS=86400
CACHE_TTL_PLAYERS=86400
CACHE_TTL_EVENTS_FINISHED=2592000
CACHE_TTL_EVENTS_UPCOMING=300
CACHE_TTL_EVENTS_LIVE=15
CACHE_TTL_STANDINGS=3600
CACHE_TTL_NEWS=1800

# ==================== FEATURES ====================
MOCK_DATA=false
LIVE_POLLING=true
PREDICTIONS_ENABLED=true
GAMIFICATION_ENABLED=true

# ==================== SYNC CONFIGURATION ====================
SYNC_DAILY_HOUR=2
SYNC_HOURLY_INTERVAL=60
SYNC_LIVE_INTERVAL=10
SYNC_LIVE_MAX_CONCURRENT=5

# ==================== CORS ====================
CORS_ORIGIN=*

# ==================== LOGGING ====================
LOG_LEVEL=info
LOG_FORMAT=json

# Google sign-in. Configure the exact callback in Google Cloud.
# Local callback: http://localhost:3000/api/v1/personal/google/callback
APP_ORIGIN=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
