{
  "name": "wagerline-api",
  "version": "1.0.0",
  "description": "WAGERline Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/jobs/migrate.ts",
    "db:seed": "tsx src/seeds/seed.ts",
    "sync": "npm run sync:verified",
    "sync:real": "tsx src/jobs/syncRealData.ts",
    "sync:news": "tsx src/jobs/syncNews.ts",
    "sync:sports": "tsx src/jobs/syncSports.ts",
    "sync:live": "tsx src/jobs/syncLive.ts",
    "sync:logos": "node scripts/sync-official-logos.cjs && node scripts/sync-team-badges.cjs && node scripts/cache-team-logos.cjs",
    "sync:results": "node scripts/sync-official-results.cjs",
    "sync:football": "node scripts/sync-football-fixtures.cjs",
    "cache:news-images": "node scripts/cache-news-images.cjs",
    "sync:super-lig-rosters": "tsx src/jobs/syncSuperLigRosters.ts",
    "db:audit": "node scripts/audit.cjs",
    "test:smoke": "node scripts/smoke.cjs",
    "sync:sportdb": "node scripts/sync-sportdb-seasons.cjs",
    "cache:competition-logos": "node scripts/cache-competition-logos.cjs",
    "test:personal": "node scripts/test-personal.cjs",
    "sync:verified": "tsx src/jobs/runVerifiedSync.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "axios": "^1.6.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "fastify": "^5.0.0",
    "node-cron": "^4.6.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.0.0"
  }
}
