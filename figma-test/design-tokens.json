{
  "colors": {
    "primary": {
      "50": "#EFF6FF",
      "100": "#DBEAFE",
      "200": "#BFDBFE",
      "300": "#93C5FD",
      "400": "#60A5FA",
      "500": "#3B82F6",
      "600": "#2563EB",
      "700": "#1D4ED8",
      "800": "#1E40AF",
      "900": "#1E3A8A"
    },
    "secondary": {
      "50": "#FFF7ED",
      "100": "#FFEDD5",
      "200": "#FED7AA",
      "300": "#FDBA74",
      "400": "#FB923C",
      "500": "#F97316",
      "600": "#EA580C",
      "700": "#C2410C",
      "800": "#9A360D",
      "900": "#7C2D12"
    },
    "accent": {
      "50": "#ECF8FF",
      "100": "#CFF9FE",
      "200": "#A5F3FC",
      "300": "#67E8F9",
      "400": "#22D3EE",
      "500": "#06B6D4",
      "600": "#0891B2",
      "700": "#0E7490",
      "800": "#155E75",
      "900": "#164E63"
    },
    "semantic": {
      "success": "#10B981",
      "danger": "#EF4444",
      "warning": "#F59E0B",
      "info": "#3B82F6"
    },
    "neutral": {
      "50": "#F9FAFB",
      "100": "#F3F4F6",
      "200": "#E5E7EB",
      "300": "#D1D5DB",
      "400": "#9CA3AF",
      "500": "#6B7280",
      "600": "#4B5563",
      "700": "#374151",
      "800": "#1F2937",
      "900": "#111827"
    }
  },
  "typography": {
    "font_family": {
      "sans": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
      "mono": "'Monaco', 'Menlo', 'Ubuntu Mono', 'Consolas', 'source-code-pro', monospace"
    },
    "font_size": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem",
      "4xl": "2.25rem",
      "5xl": "3rem"
    },
    "font_weight": {
      "light": 300,
      "normal": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "extrabold": 800,
      "black": 900
    },
    "line_height": {
      "tight": 1.2,
      "normal": 1.5,
      "relaxed": 1.75,
      "loose": 2
    },
    "letter_spacing": {
      "tight": "-0.02em",
      "normal": "0",
      "wide": "0.05em",
      "wider": "0.1em"
    }
  },
  "spacing": {
    "0": "0",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem",
    "20": "5rem",
    "24": "6rem",
    "32": "8rem"
  },
  "border_radius": {
    "none": "0",
    "sm": "4px",
    "base": "6px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "2xl": "20px",
    "full": "9999px"
  },
  "shadow": {
    "sm": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
    "base": "0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06)",
    "md": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06)",
    "lg": "0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05)",
    "xl": "0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04)",
    "2xl": "0 25px 50px -12px rgba(0, 0, 0, 0.25)"
  },
  "transition": {
    "fast": "150ms",
    "normal": "300ms",
    "slow": "500ms"
  },
  "breakpoints": {
    "mobile": "375px",
    "tablet": "768px",
    "desktop": "1024px",
    "large": "1440px"
  },
  "components": {
    "button": {
      "primary": {
        "background": "#1E40AF",
        "color": "#FFFFFF",
        "padding": "0.875rem 1.75rem",
        "border_radius": "8px",
        "font_weight": 600,
        "hover": {
          "background": "#3B82F6"
        }
      },
      "secondary": {
        "background": "#F3F4F6",
        "color": "#1E40AF",
        "padding": "0.875rem 1.75rem",
        "border_radius": "8px",
        "font_weight": 600,
        "hover": {
          "background": "#E5E7EB"
        }
      },
      "outline": {
        "background": "transparent",
        "border": "2px solid #1E40AF",
        "color": "#1E40AF",
        "padding": "0.875rem 1.75rem",
        "border_radius": "8px",
        "font_weight": 600
      }
    },
    "card": {
      "background": "#FFFFFF",
      "border": "1px solid #E5E7EB",
      "border_radius": "12px",
      "padding": "1.5rem",
      "shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1)"
    },
    "badge": {
      "padding": "0.4rem 0.8rem",
      "border_radius": "20px",
      "font_size": "0.875rem",
      "font_weight": 600
    },
    "input": {
      "padding": "0.75rem 1rem",
      "border": "1px solid #D1D5DB",
      "border_radius": "8px",
      "font_size": "1rem",
      "focus": {
        "border_color": "#1E40AF",
        "ring": "3px",
        "ring_color": "rgba(30, 64, 175, 0.1)"
      }
    },
    "table": {
      "header_background": "#F3F4F6",
      "header_font_weight": 600,
      "row_border": "1px solid #E5E7EB",
      "padding": "1rem"
    }
  },
  "layout": {
    "container_max_width": "1440px",
    "container_padding": "1rem",
    "grid_columns": 12,
    "grid_gap": "1.5rem"
  }
}
