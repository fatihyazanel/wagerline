# Copy these settings into the deployment environment before building.
# Required public HTTPS origin, no path, query string or trailing route.
# SITE_URL=https://your-public-domain.example

# Optional previous origins / www aliases served by this deployment.
# Redirects each listed host directly to SITE_URL with HTTP 308, keeping path/query.
# PREVIOUS_SITE_URLS=https://old-domain.example,https://www.old-domain.example
# Do not add domains you do not control. The current origin is excluded automatically.

# Optional Search Console ownership token (the content attribute only).
# GOOGLE_SITE_VERIFICATION=

# Server-side API origin. Never expose provider keys in NEXT_PUBLIC variables.
API_INTERNAL_URL=http://127.0.0.1:3101

# Without SITE_URL the site remains a noindex preview and sitemap is empty.
# Rebuild and restart after setting/changing the public origin.
